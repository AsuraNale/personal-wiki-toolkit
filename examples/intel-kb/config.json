{
  "name": "vuln-watch",
  "type": "intel",
  "language": "en",
  "topics": [
    { "key": "exploited", "label": "Actively exploited", "keywords": ["actively exploited", "exploited in the wild", "zero-day", "KEV", "emergency directive"] },
    { "key": "critical", "label": "Critical vulnerabilities", "keywords": ["CVE", "critical vulnerability", "remote code execution", "RCE", "authentication bypass", "privilege escalation"] },
    { "key": "supply-chain", "label": "Supply chain", "keywords": ["supply chain attack", "malicious package", "npm package", "PyPI", "dependency confusion", "typosquatting"] },
    { "key": "advisories", "label": "Vendor advisories & patches", "keywords": ["security advisory", "security update", "patch Tuesday", "out-of-band patch"] }
  ],
  "sources": [
    { "kind": "rss", "name": "cisa-advisories", "url": "https://www.cisa.gov/cybersecurity-advisories/all.xml", "topic": "advisories" },
    { "kind": "rss", "name": "bleepingcomputer", "url": "https://www.bleepingcomputer.com/feed/", "topic": "exploited" },
    { "kind": "rss", "name": "krebs-on-security", "url": "https://krebsonsecurity.com/feed/", "topic": "exploited" },
    { "kind": "rss", "name": "the-hacker-news", "url": "https://feeds.feedburner.com/TheHackersNews", "topic": "critical" },
    { "kind": "rss", "name": "schneier", "url": "https://www.schneier.com/feed/atom/", "topic": "critical" },
    { "kind": "hn", "name": "hn-vulnerability", "query": "vulnerability", "min_points": 50 }
  ],
  "thresholds": { "keep": 0.7 },
  "cadence": "daily",
  "keeper": { "enabled": true, "name": "Sentry" },
  "demand_tracking": { "enabled": true, "propose_threshold": 3 },
  "paths": { "notes": "notes", "briefs": "briefs", "inbox": "inbox", "pipeline": "_pipeline" },
  "toolkit_version": "0.1.4"
}
